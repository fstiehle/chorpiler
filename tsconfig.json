{
  "compilerOptions": {
    "strict": true,
    "module": "node16",
    "esModuleInterop": true,
    "declaration": true,
    "target": "es2020",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "outDir": "lib",
  },
  "include": ["./**/*.ts"],
  "exclude": ["src/Generator/templates", "node_modules", "lib"],
}
