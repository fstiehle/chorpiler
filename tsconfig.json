{
  "compilerOptions": {
    "strict": true,
    "module": "node16",
    "esModuleInterop": true,
    "declaration": true,
    "target": "es2022",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "outDir": "lib",
    "sourceMap": true,
    "inlineSources": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["src/Generator/Encoding/templates", "node_modules", "lib"],
}
