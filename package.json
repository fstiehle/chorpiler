{
  "name": "chorpiler",
  "version": "0.2.0-alpha.39",
  "description": "",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "npm run test test/compiler && npm run test test/output",
    "test/pckg": "node --import tsx/esm --test tests/index.test.ts",
    "test/comp": "node --import tsx/esm --test tests/parser.test.ts && node --import tsx/esm --test tests/generator.test.ts",
    "test/exec": "node --import tsx/esm --test tests/execution.test.ts",
    "test/simu": "node --import tsx/esm --test tests/simulator/*.test.ts",
    "build": "tsc -p tsconfig.build.json && ncp ./src/Generator/templates ./lib/Generator/templates && ncp ./src/Simulator/templates ./lib/Simulator/templates",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build && npm run test/pckg",
    "clean": "rm -rf lib",
    "script/gen": "node --import tsx/esm tests/scripts/generate-logs.ts"
  },
  "author": "Fabian Stiehle",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.8",
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.4",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.0.6",
    "@types/seed-random": "^2.2.4",
    "hardhat": "^3.1.3",
    "ncp": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.44.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.3",
    "mustache": "^4.2.0",
    "seed-random": "^2.2.0"
  }
}
