{
  "name": "chorpiler",
  "version": "0.2.0-alpha.41",
  "description": "",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib/**/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test/pckg && npm run test/simu && npm run test/comp && npx hardhat clean && npx hardhat compile && npm run test/root && npm run test/exec",
    "test/pckg": "node --enable-source-maps --import tsx/esm --test tests/index.test.ts",
    "test/comp": "node --enable-source-maps --import tsx/esm --test tests/parser.test.ts && node --enable-source-maps --import tsx/esm --test tests/generator.test.ts",
    "test/exec": "node --enable-source-maps --import tsx/esm --test tests/execution.test.ts && node --enable-source-maps --import tsx/esm --test tests/execution-calls.test.ts",
    "test/root": "node --enable-source-maps --import tsx/esm --test tests/channel-root.test.ts",
    "test/debg": "node --enable-source-maps --import tsx/esm --test --test-only tests/generator.test.ts",
    "test/simu": "node --enable-source-maps --import tsx/esm --test tests/simulator/*.test.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p lib && rsync -av --prune-empty-dirs --include='*/' --include='*.handlebars.*' --exclude='*' src/ lib/",
    "prepublishOnly": "npm run build",
    "preversion": "npm run build && npm run test/pckg",
    "clean": "rm -rf lib",
    "script/simu": "node --enable-source-maps --import tsx/esm tests/helpers/scripts/generate-logs.ts",
    "script/fuzz": "node --enable-source-maps --import tsx/esm tests/helpers/scripts/generate-nonlogs.ts"
  },
  "author": "Fabian Stiehle",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.4",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.11",
    "@nomicfoundation/hardhat-viem": "^3.0.4",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^25.5.0",
    "@types/seed-random": "^2.2.4",
    "hardhat": "^3.1.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.47.4"
  },
  "dependencies": {
    "@types/mustache": "^4.2.6",
    "fast-xml-parser": "^5.5.6",
    "handlebars": "^4.7.8",
    "mustache": "^4.2.0",
    "seed-random": "^2.2.0"
  }
}
